AZURE_DEPLOYMENT_CHILD=gpt-4.1

# Optional embedding deployment (recommended: text-embedding-3-large)
AZURE_EMBEDDING_DEPLOYMENT=

VECTOR_DB_DIR=online/.chroma_db
UPLOAD_DIR=online/uploaded_docs
